  { key: 'ecommerce', name: 'E-commerce', defaultModules: ['Tasks','Goals','Calendar','Product','Marketplace','Analytics','Finance','Marketing','ContentOS'] },
  { key: 'content_creator', name: 'Content / Creator', defaultModules: ['Tasks','Goals','Calendar','ContentOS','Analytics','Marketing','Finance','Affiliate'] },
  { key: 'blog_seo', name: 'Blog / SEO', defaultModules: ['Tasks','Goals','Calendar','ContentOS','Knowledge','Analytics','Marketing'] },
  { key: 'affiliate', name: 'Affiliate', defaultModules: ['Tasks','Goals','Calendar','ContentOS','Analytics','Marketing','Finance','Affiliate'] },
  { key: 'digital_product', name: 'Digital Product', defaultModules: ['Tasks','Goals','Calendar','Product','ContentOS','Analytics','Finance','Marketing'] },
  { key: 'delivery_logistics', name: 'Delivery / Logistics', defaultModules: ['Tasks','Goals','Calendar','Operations','Analytics','Finance','Support'] },
  { key: 'service_business', name: 'Service Business', defaultModules: ['Tasks','Goals','Calendar','Customers','Operations','Finance','Analytics','Support','ContentOS'] },
